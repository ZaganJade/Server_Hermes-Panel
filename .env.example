APP_NAME="Hermes Panel"
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Set this to the canonical URL the panel is reachable on. When the panel
# is served behind a reverse proxy with TLS termination (Cloudflare,
# Caddy, Nginx host), use the https:// URL.
APP_URL=http://127.0.0.1:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hermes_panel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Force-secure cookies when serving over HTTPS (public domain). Leave
# blank or set to false when running on plain HTTP behind a tunnel.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=file
QUEUE_CONNECTION=database

# Broadcasting
# Reverb is the WebSocket server used by the real-time terminal (v3.1).
# It runs internally on port 8081 (see docker/supervisord.conf) and is
# reverse-proxied through nginx at /app, so the browser connects to
# wss://<your-domain>/app in production.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=hermes-panel
REVERB_APP_KEY=changeme-app-key
REVERB_APP_SECRET=changeme-app-secret
# Public hostname browsers will connect to (Caddy/Cloudflare in front).
# Use the panel's public domain in production (e.g. panel.example.com).
REVERB_HOST=127.0.0.1
REVERB_PORT=443
REVERB_SCHEME=https
# Internal bind for the reverb server inside the container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

# Panel Configuration
PANEL_NAME="Hermes Panel"

# Authentication
# Hermes Panel is built for developers managing their own VPS. Auth is ON
# by default — session login, header password (X-Panel-Password), and
# WhatsApp number bypass are enforced. Only set PANEL_AUTH_ENABLED=false on
# a trusted network (SSH tunnel / VPN / private LAN), and only together
# with PANEL_DEV_BYPASS=true; in production the panel refuses to boot if
# auth is disabled without that explicit dev-bypass.
PANEL_AUTH_ENABLED=true
PANEL_DEV_BYPASS=false

PANEL_USERNAME=admin
PANEL_PASSWORD=changeme
PANEL_OWNER_NUMBERS=
# Idle timeout in minutes. Refreshes on every authenticated HTTP request
# to the panel; WebSocket messages do NOT refresh this timer. Set to a
# higher value for development convenience, but keep low (15-30) on
# public domains so abandoned sessions clean themselves up.
PANEL_SESSION_LIFETIME=15

PANEL_PROJECTS_DIR=Project
PANEL_MAX_UPLOAD_SIZE=10485760

# Vite-exposed Reverb client config
# Read at build time by resources/js/echo.js to connect the browser to
# the WebSocket. Keep in sync with the server-side REVERB_* values above.
# In production behind HTTPS, set VITE_REVERB_PORT=443 and
# VITE_REVERB_SCHEME=https. For local HTTP development with the
# container exposing 8081 directly, use VITE_REVERB_PORT=8081 and
# VITE_REVERB_SCHEME=http.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
